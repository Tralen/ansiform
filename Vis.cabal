name:                Vis
version:             0.1.0.0
synopsis:            Display formatting for command line interfaces.
description:         Basic format structures for building an ANSI command line interface with colors, alignment, columns, tables and more.
license:             GPL-3
license-file:        LICENSE
author:              Tunai Raiol
maintainer:          t.r@gmx.com
copyright:           All rights reserved
category:            Interface
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >= 2.0

library
  exposed-modules:     Vis
  other-modules:       Vis.Builder
                     , Vis.Content
                     , Vis.Number
                     , Vis.Page
                     , Vis.Print
                     , Vis.Printer
                     , Vis.Section
                     , Vis.Settings
                     , Vis.Style
                     , Vis.Terminal
                     , Vis.Utils
  default-extensions:  GeneralizedNewtypeDeriving
  build-depends:       base >= 4.10
                     , ansi-terminal >= 0.8
                     , terminal-size >= 0.3
                     , split >= 0.2
  hs-source-dirs:      src
  default-language:    Haskell2010
