name:                vis
version:             0.2.2.0
synopsis:            Display formatting for command line interfaces.
description:         Basic format DSL for building an ANSI command line interface with colors, alignment, tables, paragraphs and more.
license:             GPL-3
license-file:        LICENSE
author:              Tunai Raiol
maintainer:          tunairaiol@yahoo.co.uk
copyright:           All rights reserved
category:            Interface
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >= 2.0

library
  exposed-modules:     Vis

  other-modules:       Vis.Content
                     , Vis.Draw
                     , Vis.Page
                     , Vis.Printer
                     , Vis.Section
                     , Vis.Settings
                     , Vis.Style
                     , Vis.Internal
                     , Vis.Internal.Content
                     , Vis.Internal.Number
                     , Vis.Internal.Page
                     , Vis.Internal.Printer
                     , Vis.Internal.Result
                     , Vis.Internal.Section
                     , Vis.Internal.Settings
                     , Vis.Internal.State
                     , Vis.Internal.Style
                     , Vis.Internal.Terminal
                     , Vis.Internal.Utils

  default-extensions:

  build-depends:       base >= 4.10
                     , ansi-terminal >= 0.8
                     , terminal-size >= 0.3
                     , split >= 0.2

  hs-source-dirs:      src
  
  default-language:    Haskell2010
